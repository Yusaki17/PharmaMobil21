CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    descripcion TEXT NOT NULL DEFAULT '',
    categoria TEXT NOT NULL DEFAULT 'Sin categoría',
    estado INTEGER NOT NULL DEFAULT 1,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT,
    fallida INTEGER NOT NULL DEFAULT 0
);

listarTodos:
SELECT *
FROM producto
ORDER BY nombre ASC;

listarPendientes:
SELECT *
FROM producto
WHERE pendiente = 1;

pendientesPorEnviar:
SELECT *
FROM producto
WHERE pendiente = 1
  AND fallida = 0
  AND intentos < :maxIntentos
ORDER BY id;

contarPendientes:
SELECT COUNT(*)
FROM producto
WHERE pendiente = 1
  AND fallida = 0;

contarFallidas:
SELECT COUNT(*)
FROM producto
WHERE pendiente = 1
  AND fallida = 1;

insertar:
INSERT OR REPLACE INTO producto (
    id,
    nombre,
    precio,
    stock,
    descripcion,
    categoria,
    estado,
    pendiente
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

borrarSincronizados:
DELETE FROM producto
WHERE pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0)
FROM producto;

marcarSincronizado:
UPDATE producto
SET id = :idReal,
    pendiente = 0,
    intentos = 0,
    ultimoError = NULL,
    fallida = 0
WHERE id = :idLocal;

sumarIntento:
UPDATE producto
SET intentos = intentos + 1,
    ultimoError = :mensaje,
    fallida = CASE
        WHEN intentos + 1 >= :maxIntentos THEN 1
        ELSE 0
    END
WHERE id = :id;

marcarFallida:
UPDATE producto
SET fallida = 1,
    ultimoError = :mensaje
WHERE id = :id;
reiniciarEnvio:
UPDATE producto
SET intentos = 0, ultimoError = NULL, fallida = 0
WHERE id = :id AND pendiente = 1 AND fallida = 1;
